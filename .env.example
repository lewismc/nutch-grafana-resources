# Environment Configuration for Apache Nutch Grafana Monitoring Stack
# Copy this file to .env and update with your values:
#   cp .env.example .env

# =============================================================================
# DEPLOYMENT MODE
# =============================================================================

# Deployment mode: 'local' or 'cloud'
# - local: Uses local Loki and Prometheus (run with: docker compose --profile local up -d)
# - cloud: Sends data to Grafana Cloud (run with: docker compose up -d)
DEPLOYMENT_MODE=local

# =============================================================================
# NUTCH LOGS CONFIGURATION
# =============================================================================

# Path to Nutch logs directory on the host machine
# This directory will be mounted into the Alloy container
# Example: /home/user/nutch/runtime/local/logs
NUTCH_LOGS_PATH=./sample-logs

# =============================================================================
# GRAFANA CONFIGURATION
# =============================================================================

# Grafana admin credentials
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Grafana port (default: 3000)
GRAFANA_PORT=3000

# Grafana root URL (used for links in notifications)
GRAFANA_ROOT_URL=http://localhost:3000

# =============================================================================
# LOCAL MODE - Service Ports
# =============================================================================

# Alloy HTTP port for UI and metrics (default: 12345)
ALLOY_HTTP_PORT=12345

# Loki port (default: 3100)
LOKI_PORT=3100

# Prometheus port (default: 9090)
PROMETHEUS_PORT=9090

# =============================================================================
# CLOUD MODE - Grafana Cloud Credentials
# =============================================================================
# Only required when DEPLOYMENT_MODE=cloud

# Loki endpoint URL
# Example: https://logs-prod-us-central1.grafana.net/loki/api/v1/push
LOKI_URL=

# Loki username (your Grafana Cloud user ID)
LOKI_USERNAME=

# Prometheus remote write URL
# Example: https://prometheus-prod-us-central1.grafana.net/api/prom/push
PROMETHEUS_URL=

# Prometheus username (your Grafana Cloud user ID)
PROMETHEUS_USERNAME=

# Grafana Cloud API key
# Create at: Grafana Cloud > My Account > API Keys
# Required scopes: metrics:write, logs:write
GRAFANA_CLOUD_API_KEY=
